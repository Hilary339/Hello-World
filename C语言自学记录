在这里，我将记录我的C语言学习过程中遇到的问题与其解决方法和注意事项

一、Hello World
程序如下：
#include<stdio.h>  //引入标准库，printf函数就位于该库中
int main()         //设置主函数main
{
  printf("Hello,World!");    //调用标准库函数，注意括号内应是双引号,别忘了；结尾
  return 0;      //用return来结尾。
}

注意这里printf函数与python中print的区别是，C中的printf不会自动换行。

二、循环
写一个关于摄氏度华氏度对应表格的程序如下：
#include<stdio.h>
/*当 fahr=0，20，… ，300 时，分别
 打印华氏温度与摄氏温度对照表*/
int main()
{
  int fahr,celsius;              //C语言中的变量需要在运行语句之前写出，int代表后面的变量是整数，同理可以换成float
  int lower, upper, step;
  lower = 0;                    //对变量进行赋值
  upper = 300;
  step = 20;
  fahr = lower;

  printf("fahr\tcelsius\n");

  while(fahr<=upper){            //循环语句，while后的括号内表示循环条件，花括号表示循环内容
    celsius = (farh-32) * 5 / 9;    //这里注意不能写成（5/9），因为这计算的结果是整数，也就是0，但是可以写成（5.0/9.0）,这样计算出来就是不为零的浮点数。
    printf("%d\t%d\n", fahr, celsius);  //这里是对变量进行打印，%d代表整数变量（同理%f是浮点数变量），每一个%d都对应着后面的一个变量名，\t表示制表符，\n表示换行。
    /*此处为了让画面更加美观，可以进行一下修改：
      printf("%3d %6d\n",fahr,celsius);
      这表示让第一个数字占三格，第二个数字占6格，同时右对齐。
      如果是浮点数的话，可以写成类似于%3.1f的形式，这表示该浮点数占3格，保留一位小数。*/
    fahr += step;
  }
  return 0;
}
